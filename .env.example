# === Obsidian Settings ===
DN_OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault
DN_OBSIDIAN_DAILY_NOTES_FOLDER=Daily Notes
DN_OBSIDIAN_DATE_FORMAT=%Y-%m-%d

# === Output Settings ===
# Leave empty to save into the Obsidian daily notes folder
DN_OUTPUT_PATH=

# === API Authentication ===
# Set a strong token for API access from iOS Shortcuts
DN_API_TOKEN=your-secret-token-here

# === Notification Method ===
# Options: "google_chat", "line", "slack", "pushover", "none"
DN_NOTIFICATION_METHOD=google_chat

# === Google Chat (Recommended) ===
# Create a webhook in Google Chat:
#   Space settings > Apps & integrations > Webhooks > Create
DN_GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXXXX/messages?key=YOUR_KEY&token=YOUR_TOKEN

# === LINE Notify ===
# Get token from: https://notify-bot.line.me/my/
DN_LINE_NOTIFY_TOKEN=

# === Slack ===
# Create an Incoming Webhook: https://api.slack.com/messaging/webhooks
DN_SLACK_WEBHOOK_URL=

# === Pushover ===
# Sign up at: https://pushover.net/
DN_PUSHOVER_USER_KEY=
DN_PUSHOVER_API_TOKEN=

# === Server ===
DN_HOST=0.0.0.0
DN_PORT=8000
